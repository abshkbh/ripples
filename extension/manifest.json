{
  "manifest_version": 3,
  "name": "Ripples",
  "version": "0.2.0",
  "description": "Local movement tracking, an event log, and better viewing controls for my.nanit.com.",
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["https://my.nanit.com/*"],
    "js": ["core.js", "audio.js", "preferences.js", "alerts.js", "styles.js", "view.js", "content.js"],
    "run_at": "document_idle"
  }]
}
